# Copy to backend/.env for local development. Never commit backend/.env.
APP_ENV=development

# Gemini authentication (choose ONE).
# Option A - Gemini API key from Google AI Studio (simplest):
GOOGLE_GENAI_USE_VERTEXAI=FALSE
GOOGLE_API_KEY=replace-with-your-key
# Option B - Vertex AI with Application Default Credentials:
# GOOGLE_GENAI_USE_VERTEXAI=TRUE
# GOOGLE_CLOUD_PROJECT=your-project-id
# GOOGLE_CLOUD_LOCATION=us-central1

# Agent bounds and model.
RULEPILOT_GEMINI_MODEL=gemini-3.8-flash
# Tried in order when the primary model is overloaded, before any tool call.
RULEPILOT_GEMINI_FALLBACK_MODELS=gemini-flash-latest,gemini-3.6-flash,gemini-3.5-flash-lite
RULEPILOT_AGENT_MAX_LLM_CALLS=12
RULEPILOT_AGENT_TIMEOUT_SECONDS=120

# Governance storage: local (JSON files in RULEPILOT_DATA_DIR) or firestore.
# Firestore uses Application Default Credentials and GOOGLE_CLOUD_PROJECT.
RULEPILOT_STORE=local

# Comma-separated dashboard origins allowed to call the API in split local mode.
RULEPILOT_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
